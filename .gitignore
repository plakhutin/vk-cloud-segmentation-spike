# Terraform working data and state; keep .terraform.lock.hcl tracked.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# Credentials and private keys.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
kubeconfig

# Temporary files.
*.tmp
*.swp
*~

# Saved Terraform plans.
*.tfplan
*.tfplan.*
